# Base domain for the tools — NO subdomain, NO protocol.
#   production:  contracommerce.com
#   local dev:   localhost:3000   (browsers resolve *.localhost automatically)
# Hub is served at  tools.<domain>  and each tool at  <slug>.<domain>.
NEXT_PUBLIC_TOOLS_DOMAIN=localhost:3000
# Set true when all tools should use paths on one host instead of wildcard subdomains.
NEXT_PUBLIC_TOOLS_PATH_ROUTING=false

# --- Data storage (Neon PostgreSQL). Optional — tools work without it. ---
# Apply the schema once:  psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require
# Required before persisting one-way identifiers for courier-risk checks.
# If unset, the free-tools app does not store a phone identifier.
# PHONE_HASH_SECRET=<at least 32 random characters>
# Encrypts saved courier credentials. If omitted, PHONE_HASH_SECRET is used.
# Local development automatically creates an ignored key under apps/web/.data.
# COURIER_CONNECTION_ENCRYPTION_KEY=<at least 32 random characters>
# Signs anonymous workspace cookies so public users cannot access one another's connections.
# If omitted, PHONE_HASH_SECRET is used.
# COURIER_WORKSPACE_SECRET=<at least 32 random characters>
# Production health and lead retry endpoints use this server-only secret.
# CRON_SECRET=<at least 32 random characters>

# Where client calculators POST usage. Set to enable calculator tracking;
# leave unset in a host app (e.g. the SaaS) to disable it.
NEXT_PUBLIC_TRACK_ENDPOINT=/api/event

# --- Optional integrations ---
# AI copy tools: set to generate real copy (else a template fallback is used).
# ANTHROPIC_API_KEY=sk-ant-...
# CONTRA_LLM_MODEL=claude-opus-4-8   # or claude-haiku-4-5 for cheaper, high-volume use

# Courier tracking, history and booking use encrypted merchant connections saved
# through /courier-settings; no separate CFC service or API key is required.

# Courier comparison: optional live/provider or merchant-contract rate bridge.
# POST receives pickupDistrict, destinationDistrict, destinationArea, zone,
# weightKg and codAmount, and returns { mode: "live"|"contract", asOf, quotes }.
# Unset = sourced public-rate fallback with visible source/review date.
# COURIER_RATES_API_URL=https://api.contracommerce.com/v1/couriers/rates
# COURIER_RATES_API_KEY=<server-side rate service key>

# Store Health Checker: optional Google PageSpeed key for higher mobile-speed
# quota (works without a key at low volume; the check is skipped if unavailable).
# PAGESPEED_API_KEY=

# Durable CRM/email delivery. Every consented lead is stored first, then this
# endpoint receives a signed `lead.created` event and is retried with backoff.
# LEAD_WEBHOOK_URL=https://crm.example.com/webhooks/contra-leads
# LEAD_WEBHOOK_SECRET=<at least 32 random characters>
