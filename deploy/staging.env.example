# Public DNS and Let's Encrypt
BASE_DOMAIN=staging.contracommerce.com
ACME_EMAIL=ops@contracommerce.com
# Cloudflare token needs Zone:DNS:Edit only for BASE_DOMAIN.
CLOUDFLARE_API_TOKEN=

# Images may be replaced with registry tags after CI builds.
TOOLS_IMAGE=contra-commerce-tools:staging
COURIER_IMAGE=contra-commerce-courier:staging

# Smoke test
STAGING_ORIGIN=https://tools.staging.contracommerce.com
# Optional authenticated session forwarded to protected booking/settings routes.
STAGING_COOKIE=

# Destructive sandbox booking is disabled unless both flags are true.
SMOKE_COURIER_BOOKING=true
CONFIRM_SANDBOX_COURIER=true
SANDBOX_COURIER_ID=mock
SANDBOX_CUSTOMER_PHONE=01700001111
SANDBOX_CUSTOMER_NAME=Contra Commerce Sandbox
SANDBOX_DELIVERY_ADDRESS=Sandbox test address, Dhaka
SANDBOX_COD_AMOUNT=0
SANDBOX_WEIGHT_KG=0.5

# Live history assertion is disabled until a licensed courier/aggregator test
# number is supplied.
REQUIRE_LIVE_HISTORY=true
SANDBOX_HISTORY_PHONE=01700001111
